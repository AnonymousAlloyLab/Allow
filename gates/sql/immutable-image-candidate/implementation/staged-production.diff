+            return original(descriptor, count)
+        before = fd_count()
+        with patch.object(init_module.os, 'read', side_effect=changed), self.assertRaises(ValueError):
+            init_module.build_image(source, size, digest)
+        self.assertEqual(fd_count(), before)
