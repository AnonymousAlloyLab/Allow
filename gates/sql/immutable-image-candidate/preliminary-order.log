Allow.DocumentOrder.accepted_ids_preserved {owners : List Allow.DocumentDraft.Id}
  {fields : List Allow.DocumentDraft.Field} (h : Allow.DocumentOrder.accepts owners fields = true) :
  List.map Allow.DocumentDraft.Field.id (Allow.DocumentOrder.groupedFields owners fields) =
    List.map Allow.DocumentDraft.Field.id fields
Allow.DocumentOrder.accepts_exact (owners : List Allow.DocumentDraft.Id) (fields : List Allow.DocumentDraft.Field) :
  Allow.DocumentOrder.accepts owners fields = true ↔ Allow.DocumentOrder.groupedFields owners fields = fields
Allow.DocumentOrder.empty_order_accepts : Allow.DocumentOrder.accepts [] [] = true
Allow.DocumentOrder.grouped_order_accepts :
  Allow.DocumentOrder.accepts [1, 2]
      [{ id := 7, owner := 1, range := [1], multiplicity := Allow.DocumentDraft.Multiplicity.set },
        { id := 9, owner := 1, range := [1], multiplicity := Allow.DocumentDraft.Multiplicity.set },
        { id := 8, owner := 2, range := [1], multiplicity := Allow.DocumentDraft.Multiplicity.set }] =
    true
Allow.DocumentOrder.guarded_admitted_collision {decoder : Allow.DocumentDraft.WireDecoder}
  {parser : Allow.DocumentDraft.ParserAdmission} {frame : Allow.DocumentDraft.CheckedFrameBinding} {auth : Prop}
  {s : Allow.DocumentDraft.State} {k : Allow.DocumentDraft.Scope} {q : Allow.DocumentDraft.Request}
  {a : Allow.DocumentDraft.Artifact} {r : Allow.DocumentDraft.Receipt} (ha : auth)
  (hr : Allow.DocumentDraft.receipt s k = some r) (different : r.requestWire ≠ q.wire) :
  Allow.DocumentOrder.GuardedAdmittedStep decoder parser frame auth s k q a Allow.DocumentDraft.Result.collision s
Allow.DocumentOrder.guarded_admitted_deny_auth {decoder : Allow.DocumentDraft.WireDecoder}
  {parser : Allow.DocumentDraft.ParserAdmission} {frame : Allow.DocumentDraft.CheckedFrameBinding} {auth : Prop}
  {s : Allow.DocumentDraft.State} {k : Allow.DocumentDraft.Scope} {q : Allow.DocumentDraft.Request}
  {a : Allow.DocumentDraft.Artifact} (denied : ¬auth) :
  Allow.DocumentOrder.GuardedAdmittedStep decoder parser frame auth s k q a Allow.DocumentDraft.Result.rejected s
Allow.DocumentOrder.guarded_admitted_replay {decoder : Allow.DocumentDraft.WireDecoder}
  {parser : Allow.DocumentDraft.ParserAdmission} {frame : Allow.DocumentDraft.CheckedFrameBinding} {auth : Prop}
  {s : Allow.DocumentDraft.State} {k : Allow.DocumentDraft.Scope} {q : Allow.DocumentDraft.Request}
  {a : Allow.DocumentDraft.Artifact} {r : Allow.DocumentDraft.Receipt} (ha : auth)
  (hr : Allow.DocumentDraft.receipt s k = some r) (same : r.requestWire = q.wire) :
  Allow.DocumentOrder.GuardedAdmittedStep decoder parser frame auth s k q a
    (Allow.DocumentDraft.Result.replay r.outcome) s
Allow.DocumentOrder.guarded_success_checked {auth : Prop} {s : Allow.DocumentDraft.State}
  {k : Allow.DocumentDraft.Scope} {q : Allow.DocumentDraft.Request} {a : Allow.DocumentDraft.Artifact} {n : Nat}
  {out : Allow.DocumentDraft.State}
  (h : Allow.DocumentOrder.GuardedStep auth s k q a (Allow.DocumentDraft.Result.accepted n) out) :
  Allow.DocumentDraft.CandidateValid a q.policy
Allow.DocumentOrder.guarded_success_ordered {auth : Prop} {s : Allow.DocumentDraft.State}
  {k : Allow.DocumentDraft.Scope} {q : Allow.DocumentDraft.Request} {a : Allow.DocumentDraft.Artifact} {n : Nat}
  {out : Allow.DocumentDraft.State} {m : Allow.DocumentDraft.Module}
  (h : Allow.DocumentOrder.GuardedStep auth s k q a (Allow.DocumentDraft.Result.accepted n) out)
  (block : a.moduleIR = some m) : Allow.DocumentOrder.groupedFields m.sigs m.fields = m.fields
Allow.DocumentOrder.guarded_unknown_success_ordered {auth : Prop} {s : Allow.DocumentDraft.State}
  {k : Allow.DocumentDraft.Scope} {q : Allow.DocumentDraft.Request} {a : Allow.DocumentDraft.Artifact}
  {out : Allow.DocumentDraft.State} {m : Allow.DocumentDraft.Module}
  (h : Allow.DocumentOrder.GuardedStep auth s k q a Allow.DocumentDraft.Result.unknown out)
  (block : a.moduleIR = some m) : Allow.DocumentOrder.groupedFields m.sigs m.fields = m.fields
Allow.DocumentOrder.interleaved_order_denied :
  Allow.DocumentOrder.accepts [1, 2]
      [{ id := 7, owner := 1, range := [1], multiplicity := Allow.DocumentDraft.Multiplicity.set },
        { id := 8, owner := 2, range := [1], multiplicity := Allow.DocumentDraft.Multiplicity.set },
        { id := 9, owner := 1, range := [1], multiplicity := Allow.DocumentDraft.Multiplicity.set }] =
    false
Allow.DocumentOrder.unordered_candidate_collision :
  Allow.DocumentOrder.GuardedAdmittedStep (fun x => none) (fun x => False) (fun x x_1 x_2 x_3 => False) True
    Allow.DocumentOrder.replayState Allow.DocumentDraft.exampleScope Allow.DocumentDraft.staleTextRequest
    Allow.DocumentOrder.unorderedArtifact Allow.DocumentDraft.Result.collision Allow.DocumentOrder.replayState
Allow.DocumentOrder.unordered_candidate_denied :
  ¬Allow.DocumentOrder.CandidateOrder Allow.DocumentOrder.unorderedArtifact
Allow.DocumentOrder.unordered_candidate_receipt_replay :
  Allow.DocumentOrder.GuardedAdmittedStep (fun x => none) (fun x => False) (fun x x_1 x_2 x_3 => False) True
    Allow.DocumentOrder.replayState Allow.DocumentDraft.exampleScope Allow.DocumentDraft.exampleRequest
    Allow.DocumentOrder.unorderedArtifact
    (Allow.DocumentDraft.Result.replay (Allow.DocumentDraft.Outcome.committed 1 [])) Allow.DocumentOrder.replayState
